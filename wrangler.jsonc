{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "insurance-app-uat",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": ["sentry-logs"],
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": ["sentry-traces"],
    },
  },
  "upload_source_maps": true,
  "placement": {
    "mode": "smart",
  },
  "limits": {
    "cpu_ms": 60000,
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "uat.irecon.net",
      "custom_domain": true,
    },
  ],
  "services": [
    {
      "binding": "EXCEL_SERVICE",
      "service": "insurance-excel-worker-uat",
    },
    {
      "binding": "PDF_SERVICE",
      "service": "insurance-pdf-worker-uat",
    },
  ],
  // SUPABASE_URL is not set here — local dev reads it from `.env` (local Supabase).
  // UAT/prod deploy injects SUPABASE_URL via deployment/lib/preview-env.mjs (uatAppWrangler).
  "vars": {
    "SESSION_INACTIVITY_TIMEOUT_MINUTES": "30",
    "SESSION_ABSOLUTE_TIMEOUT_HOURS": "12",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "644e1eb7dcb74d6c821bb8befdd5ff80",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "insurance-app-avatars-local",
      // Local dev reads the dedicated local R2 bucket (populate via `npm run deployment:bootstrap:r2`).
      "remote": true,
    },
    {
      "binding": "LIBRARY_DOCUMENTS",
      "bucket_name": "insurance-app-library-documents-local",
      "remote": true,
    },
    {
      "bucket_name": "insurance-app-avatars-local",
      "binding": "insurance_app_avatars_local",
      "remote": true,
    },
    {
      "bucket_name": "insurance-app-library-documents-local",
      "binding": "insurance_app_library_documents_local",
      "remote": true,
    },
  ],
}
