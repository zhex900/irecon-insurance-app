# Copy to `.env` for local development (`pnpm run dev`).
# After `pnpm run db:start`, run `pnpm run db:status` for Supabase keys.

# Postgres (local Supabase CLI — port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Hyperdrive local override (wrangler.jsonc still references UAT Hyperdrive id)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Auth (local Supabase CLI — port 54321; keys from `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

APP_URL=http://localhost:5173
NODE_ENV=development

SESSION_INACTIVITY_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

RESEND_API_KEY=
EMAIL_FROM=Irecon Insurance <noreply@example.com>

# Leave empty locally to skip Turnstile on login
TURNSTILE_SECRET_KEY=

SENTRY_DSN=

DOCUMENT_SERVICE_URL=http://localhost:8787
EXCEL_WORKER_URL=http://localhost:8788
