# Supabase local Postgres (default after `supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Required for `npm run dev` with the Cloudflare Vite plugin (Hyperdrive binding).
# Use the same local Postgres URL as DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth — copy from `supabase status -o env` (API_URL, ANON_KEY, SERVICE_ROLE_KEY)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App version label in the sidebar (defaults to "local" in `npm run dev`)
# PR preview: PR-<number>  |  staging: staging-<commit>  |  prod: release tag
# VITE_APP_VERSION=local

# Sentry (optional locally). Public DSN is safe for the browser; Worker uses SENTRY_DSN.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Source map upload (deploy / CI only — never commit the token):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Public origin for auth emails (password reset). Set this locally so links stay on :5173
# even if Vite briefly binds elsewhere. Must match supabase/config.toml [auth].site_url.
APP_URL=http://127.0.0.1:5173

# Resend — policy document email (server-only; never expose to the browser)
# Local/dev: use a Resend test key + onboarding@resend.dev, or leave unset to see a clear error on send.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Irecon Insurance <onboarding@resend.dev>
# EMAIL_REPLY_TO=

# E2E (optional overrides; defaults match seeded demo users)
# E2E_BASE_URL=http://127.0.0.1:5173
# E2E_BROKER_EMAIL=broker@demo.local
# E2E_BROKER_PASSWORD=password123
# E2E_ADMIN_EMAIL=admin@demo.local
# E2E_SUPER_ADMIN_EMAIL=

# Cloudflare Turnstile (login). Omit both to skip locally; use test keys to exercise the widget.
# Create production keys: Cloudflare dashboard → Turnstile → Add widget (domains: localhost, 127.0.0.1, your host).
# Test keys (always pass): https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Staging deploy: copy .env.staging.example → .env.staging and set DATABASE_URL,
# then run `npm run deploy:staging` (loads DATABASE_URL from the environment).
