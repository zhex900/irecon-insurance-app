# Environment Variables Template
# Copy this file to .env.local and fill in the values

# Database Configuration
DATABASE_URL=postgres://...
SUPABASE_URL=https://...
SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_SECRET_KEY=...

# App Configuration
APP_URL=http://localhost:5173
NODE_ENV=development

# Session Configuration
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Email Configuration
RESEND_API_KEY=...
EMAIL_FROM=Irecon Insurance <noreply@example.com>
# AUTH_EMAIL_FROM=Irecon Insurance <noreply@example.com>
EMAIL_REPLY_TO=support@example.com

# Security Configuration
TURNSTILE_SECRET_KEY=...

# Sentry Configuration
SENTRY_DSN=...

# Local Development URLs (for development only)
DOCUMENT_SERVICE_URL=http://localhost:8787
EXCEL_WORKER_URL=http://localhost:8788

# NOTE: In production, these URLs are replaced by Service Bindings
# and are not accessible directly.