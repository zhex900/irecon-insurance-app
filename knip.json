{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "workers/pdf/index.ts",
    "workers/excel/index.ts",
    "tests/e2e/auth.setup.ts",
    "scripts/db/seed/generate-car-wording-seed.mjs",
    "scripts/test/capture-pdf-golden-references.mts",
    "scripts/test/verify-pricing.mts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "workers/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.{ts,tsx,mts,mjs}"
  ],
  "ignore": ["app/components/ui/**"],
  "ignoreDependencies": [
    "@tiptap/extension-font-family",
    "@sentry/cli",
    "@module-federation/runtime",
    "@module-federation/vite",
    "pdfjs-dist",
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    "@typescript-eslint/parser",
    "eslint-import-resolver-node",
    "cloudflare"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
