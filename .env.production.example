# Production / Cloudflare Workers deploy secrets (not used by local `npm run dev`)
# Copy to .env.production and fill in values from the production Supabase project.
#
# DATABASE_URL — use the production pooler URL (port 6543)
# SUPABASE_PUBLISHABLE_KEY — required for login (sb_publishable_...)
# SUPABASE_SECRET_KEY — required for Settings → Users admin APIs (sb_secret_...)
# APP_URL — canonical origin for emails + Supabase site_url (https://app.irecon.net)
# PRODUCTION_WRANGLER_DOMAINS — Cloudflare zones on your account (default app.irecon.net)
# PRODUCTION_AUTH_DOMAINS — Supabase Auth redirect allow list (default app.irecon.net,app.irecon.com.au)
# RESEND_API_KEY / EMAIL_FROM — outbound mail via Resend (policy documents + password reset)
#
# DATABASE_URL=postgresql://postgres.[PROD_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://[PROD_REF].supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# APP_URL=https://app.irecon.net
# PRODUCTION_AUTH_DOMAINS=app.irecon.net,app.irecon.com.au
# RESEND_API_KEY=
# EMAIL_FROM=Irecon Insurance <noreply@your-verified-domain>
# VITE_APP_VERSION — optional; deploy script defaults to production-<short-commit>
#
# Sentry — same DSN for Worker secret + Vite client build. Auth token for source maps.
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
#
# Turnstile — site key is baked into the client build (VITE_*); secret is a Worker secret.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
#
# Optional: update Supabase Auth Site URL during deploy (Management API)
# SUPABASE_ACCESS_TOKEN=   # https://supabase.com/dashboard/account/tokens
#
# Deploy applies pending supabase/migrations to production, then deploys Workers:
#   npm run deploy:prod
#
# One-off: replace production DB with a full UAT copy (destructive):
#   npm run db:copy:prod -- --confirm

DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=https://app.irecon.net
RESEND_API_KEY=
EMAIL_FROM=
# EMAIL_REPLY_TO=
# VITE_APP_VERSION=
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SUPABASE_ACCESS_TOKEN=
