{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "concurrently -k -n api,app -c blue,green \"npm run dev:api\" \"npm run dev:app\"",
    "dev:api": "json-server --watch json-server/db.json --port 3000 --host 127.0.0.1",
    "dev:app": "react-router dev",
    "db:reset": "node scripts/reset-json-db.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-router/node": "8.2.0",
    "@react-router/serve": "8.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router": "8.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "8.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.4",
    "json-server": "^0.17.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
