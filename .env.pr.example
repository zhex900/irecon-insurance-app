# Shared PR preview env — sole config for `npm run deploy -- pr-<n>`.
# UAT deploy continues to use .env.uat only.

BASE_URL=irecon.net

# PR Supabase project (target — cleared and restored on each PR deploy)
DATABASE_URL=postgresql://postgres.YOUR_PR_PROJECT_REF:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# UAT Supabase (source — copied into PR database each deploy)
UAT_DATABASE_URL=postgresql://postgres.YOUR_UAT_PROJECT_REF:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
UAT_SUPABASE_URL=https://YOUR_UAT_PROJECT_REF.supabase.co

# Cloudflare (Wrangler deploy / destroy)
# CLOUDFLARE_API_TOKEN=

# R2 S3 API (copy UAT buckets → preview on deploy; empty on destroy)
# Cloudflare dashboard → R2 → Manage R2 API tokens + S3 API endpoint
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

RESEND_API_KEY=
EMAIL_FROM=Irecon Insurance <no-reply@irecon.com.au>

SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional — Auth redirect allow list on PR project
# SUPABASE_ACCESS_TOKEN=
