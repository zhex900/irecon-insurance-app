{
  "name": "insurance-documents-domain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Documents domain for insurance app (PDF-heavy)",
  "main": "./src/index.tsx",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "deploy:staging": "wrangler deploy --config wrangler.documents.jsonc",
    "deploy:production": "wrangler deploy --config wrangler.documents.jsonc --env production",
    "analyze-bundle": "vite-bundle-analyzer"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@pdfme/common": "^6.1.12",
    "@pdfme/generator": "^6.1.12",
    "@pdfme/schemas": "^6.1.12",
    "@pdfme/ui": "^6.1.12",
    "@pdfme/converter": "^6.1.12",
    "@tiptap/core": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-font-family": "^3.29.2",
    "reui": "*"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/node": "^22.10.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@module-federation/vite": "^1.20.7",
    "@module-federation/runtime": "^2.8.2",
    "@module-federation/enhanced": "^2.8.2",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "tailwindcss": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "@tailwindcss/vite": "^4.0.0"
  },
  "peerDependencies": {
    "@module-federation/runtime": "^2.8.2"
  }
}
