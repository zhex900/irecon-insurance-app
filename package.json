{
  "name": "insurance-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "react-router build",
    "build:pdf-worker": "wrangler deploy --config wrangler.pdf.jsonc --dry-run",
    "types:pdf-worker": "wrangler types --config wrangler.pdf.jsonc --env-file workers/documents-local.env --env-interface PdfWorkerEnv --include-runtime false workers/pdf/env.d.ts",
    "dev": "react-router dev",
    "dev:pdf-worker": "wrangler dev --config wrangler.pdf.jsonc --env-file workers/documents-local.env",
    "check:bundle": "pnpm run build && node scripts/bundle/simple-bundle-check.js",
    "check:bundle:quick": "node scripts/bundle/simple-bundle-check.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:push": "drizzle-kit push",
    "db:push:templates:uat": "tsx --env-file=.env scripts/db/push-uat/push-document-templates-to-uat.mts",
    "db:push:email-templates:uat": "tsx --env-file=.env scripts/db/push-uat/push-email-templates-to-uat.mts",
    "db:push:additional-wording:uat": "tsx --env-file=.env scripts/db/push-uat/push-car-wording-to-uat.mts",
    "db:seed": "tsx --env-file=.env scripts/db/seed/seed-db.mts",
    "db:seed:ar": "tsx --env-file=.env scripts/db/seed/seed-ar-from-csv.mts",
    "db:seed:clients": "tsx --env-file=.env scripts/db/seed/seed-clients-from-csv.mts",
    "db:export:prices": "tsx scripts/db/mssql/export-prices-from-mssql.mts",
    "db:migrate:prices": "tsx --env-file=.env scripts/db/mssql/migrate-prices-from-mssql.mts",
    "db:export:legacy": "tsx scripts/db/legacy/export-legacy-domain.mts",
    "db:migrate:legacy": "tsx scripts/db/legacy/migrate-legacy-domain.mts --replace --write-json",
    "db:migrate:legacy:local": "tsx scripts/db/legacy/migrate-legacy-domain.mts --env=local --replace --only account-managers,ar,clients,policies",
    "db:migrate:legacy:uat": "tsx scripts/db/legacy/migrate-legacy-domain.mts --env=uat --confirm --replace --only account-managers,ar,clients,policies",
    "db:migrate:legacy:prod": "tsx scripts/db/legacy/migrate-legacy-domain.mts --env=prod --confirm --replace --only account-managers,ar,clients,policies",
    "db:migrate:legacy:documents:local": "tsx scripts/db/legacy/migrate-legacy-domain.mts --env=local --only documents --skip-r2 --file _archive/data/legacy-export.json",
    "db:migrate:legacy:documents:uat": "tsx scripts/db/legacy/migrate-legacy-domain.mts --env=uat --confirm --only documents --file _archive/data/legacy-export.json",
    "db:migrate:legacy:documents:prod": "tsx scripts/db/legacy/migrate-legacy-domain.mts --env=prod --confirm --only documents --file _archive/data/legacy-export.json",
    "db:seed:prices": "tsx --env-file=.env scripts/db/seed/seed-prices.mts",
    "db:seed:faker": "tsx --env-file=.env scripts/db/seed/seed-faker.mts",
    "db:clear:policies": "tsx scripts/db/clear/clear-policies.mts",
    "db:clear:clients": "tsx scripts/db/clear/clear-clients.mts",
    "db:clear:account-managers": "tsx scripts/db/clear/clear-account-managers.mts",
    "db:clear:ar": "tsx scripts/db/clear/clear-ar.mts",
    "db:clear:legacy:local": "tsx scripts/db/clear/clear-legacy-domain.mts --env=local",
    "db:clear:legacy:uat": "tsx scripts/db/clear/clear-legacy-domain.mts --env=uat",
    "db:clear:legacy:prod": "tsx scripts/db/clear/clear-legacy-domain.mts --env=prod",
    "db:clear:legacy:documents:local": "tsx --env-file=.env scripts/db/clear/clear-legacy-documents.mts --env=local",
    "db:clear:legacy:documents:uat": "tsx --env-file=.env --env-file=.env.uat scripts/db/clear/clear-legacy-documents.mts --env=uat",
    "db:clear:r2:policies:uat": "tsx --env-file=.env --env-file=.env.uat scripts/db/clear/clear-r2-policy-documents-prefix.mts --env=uat",
    "db:clear:r2:policies:prod": "tsx --env-file=.env --env-file=.env.production scripts/db/clear/clear-r2-policy-documents-prefix.mts --env=prod",
    "db:clear:legacy:documents:prod": "tsx --env-file=.env --env-file=.env.production scripts/db/clear/clear-legacy-documents.mts --env=prod",
    "db:clear:legacy:documents:pr": "tsx --env-file=.env --env-file=.env.pr scripts/db/clear/clear-legacy-documents.mts --env=pr",
    "db:repair:policy-periods": "tsx scripts/db/repair/repair-migrated-policy-periods.mts",
    "db:repair:migrated-policies": "tsx scripts/db/repair/repair-migrated-policies.mts",
    "db:repair:policy-document-r2": "tsx scripts/db/repair/repair-policy-document-r2.mts",
    "db:repair:legacy-documents-from-r2": "tsx --env-file=.env scripts/db/repair/repair-legacy-documents-from-r2.mts",
    "db:repair:legacy-documents-from-r2:uat": "tsx --env-file=.env --env-file=.env.uat scripts/db/repair/repair-legacy-documents-from-r2.mts --env=uat",
    "db:repair:policy-number-seq": "tsx --env-file=.env scripts/db/repair/ensure-policy-number-seq.mts",
    "db:reset": "supabase db reset --yes && pnpm run db:seed",
    "db:copy:uat": "node --env-file=.env --env-file=.env.uat deployment/copy-uat-to-local.mjs",
    "db:copy:prod": "node --env-file=.env.uat --env-file=.env.production deployment/copy-uat-to-prod.mjs",
    "deployment:bootstrap:r2": "node --env-file=.env --env-file=.env.uat deployment/bootstrap-r2-envs.mjs",
    "deploy": "node deployment/deploy.mjs",
    "deploy:pr": "node deployment/deploy.mjs",
    "deploy:uat": "node --env-file=.env.uat deployment/deploy.mjs",
    "deploy:prod": "node --env-file=.env.production deployment/deploy-production.mjs",
    "preview:password-reset-email": "tsx --env-file=.env scripts/dev/preview-password-reset-email.mts",
    "destroy": "node deployment/destroy-preview.mjs",
    "destroy:pr": "node deployment/destroy-preview.mjs",
    "deploy:pdf:uat": "wrangler deploy --env-file=.env.uat --config wrangler.pdf.jsonc",
    "deploy:excel:uat": "wrangler deploy --env-file=.env.uat --config wrangler.excel.jsonc",
    "dev:excel-worker": "wrangler dev --config wrangler.excel.jsonc",
    "dev:all-workers": "bash scripts/dev/start-all-workers.sh",
    "deploy:secret": "node --env-file=.env.uat deployment/deploy.mjs --secret-only",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:db": "node scripts/ci/supabase-setup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:policy-number-sql": "vitest run tests/integration/policy-number-allocation-sql.test.ts",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:local": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=http://localhost:5173 playwright test --project=e2e",
    "test:e2e:ui": "E2E_SKIP_WEBSERVER=1 playwright test --ui --project=e2e",
    "test:e2e:policy-matrix": "playwright test tests/e2e/policy-matrix.spec.ts --project=e2e",
    "test:smoke": "playwright test --project=smoke",
    "knip": "knip",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip && pnpm run test:unit && pnpm run check:bundle:quick",
    "check:organization": "./scripts/quality/check-organization.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@cloudflare/workers-types": "^5.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@pdfme/common": "^6.1.13",
    "@pdfme/generator": "^6.1.13",
    "@pdfme/schemas": "^6.1.13",
    "@pdfme/ui": "^6.1.13",
    "@react-email/editor": "^1.7.10",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@sentry/cloudflare": "^11.0.0",
    "@sentry/react-router": "^11.0.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.48.0",
    "md5": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "8.4.0",
    "resend": "^6.29.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@module-federation/runtime": "^2.9.1",
    "@module-federation/vite": "^1.22.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "8.4.0",
    "@sentry/cli": "^3.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/md5": "^2.3.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "mssql": "^12.7.2",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  }
}
