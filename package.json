{
  "name": "insurance-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "react-router build",
    "build:pdf-worker": "wrangler deploy --config wrangler.pdf.jsonc --dry-run",
    "types:pdf-worker": "wrangler types --config wrangler.pdf.jsonc --env-file workers/documents-local.env --env-interface PdfWorkerEnv --include-runtime false workers/pdf/env.d.ts",
    "dev": "react-router dev",
    "dev:pdf-worker": "wrangler dev --config wrangler.pdf.jsonc --env-file workers/documents-local.env",
    "check:bundle": "npm run build && node scripts/simple-bundle-check.js",
    "check:bundle:quick": "node scripts/simple-bundle-check.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:push": "drizzle-kit push",
    "db:push:templates:staging": "tsx --env-file=.env scripts/push-document-templates-to-staging.mts",
    "db:push:email-templates:staging": "tsx --env-file=.env scripts/push-email-templates-to-staging.mts",
    "db:push:additional-wording:staging": "tsx --env-file=.env scripts/push-car-wording-to-staging.mts",
    "db:seed": "tsx --env-file=.env scripts/seed-db.mts",
    "db:seed:ar": "tsx --env-file=.env scripts/seed-ar-from-csv.mts",
    "db:seed:clients": "tsx --env-file=.env scripts/seed-clients-from-csv.mts",
    "db:export:prices": "tsx scripts/export-prices-from-mssql.mts",
    "db:migrate:prices": "tsx --env-file=.env scripts/migrate-prices-from-mssql.mts",
    "db:seed:prices": "tsx --env-file=.env scripts/seed-prices.mts",
    "db:seed:faker": "tsx --env-file=.env scripts/seed-faker.mts",
    "db:reset": "supabase db reset --yes && npm run db:seed",
    "deploy": "node --env-file=.env.staging scripts/deploy-staging.mjs",
    "deploy:staging": "node --env-file=.env.staging scripts/deploy-staging.mjs",
    "deploy:pdf:staging": "wrangler deploy --config wrangler.pdf.jsonc",
    "deploy:excel:staging": "wrangler deploy --config wrangler.excel.jsonc",
    "dev:excel-worker": "wrangler dev --config wrangler.excel.jsonc",
    "dev:all-workers": "node scripts/dev-all-workers.js",
    "dev:both-workers": "bash scripts/start-both-workers.sh",
    "deploy:secret": "node --env-file=.env.staging scripts/deploy-staging.mjs --secret-only",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:local": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=http://localhost:5173 playwright test --project=e2e",
    "test:e2e:ui": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=http://localhost:5173 playwright test --project=e2e --ui",
    "test:smoke": "playwright test --project=smoke",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run check:bundle:quick",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@cloudflare/workers-types": "^5.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@pdfme/common": "^6.1.12",
    "@pdfme/generator": "^6.1.12",
    "@pdfme/schemas": "^6.1.12",
    "@pdfme/ui": "^6.1.12",
    "@react-email/editor": "^1.7.1",
    "@react-router/cloudflare": "^8.3.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@sentry/cloudflare": "^10.70.0",
    "@sentry/react-router": "^10.69.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-font-family": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "isbot": "^5.2.1",
    "lucide-react": "^1.31.0",
    "md5": "^2.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "8.3.0",
    "resend": "^6.18.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@module-federation/vite": "^1.20.7",
    "@module-federation/runtime": "^2.8.2",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@sentry/cli": "^3.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/md5": "^2.3.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mssql": "^12.7.0",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
