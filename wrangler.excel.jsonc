{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "insurance-excel-worker-staging",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/excel/index.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": ["sentry-logs"],
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": ["sentry-traces"],
    },
  },
  "vars": {
    "WORKER_VERSION": "2.0.0",
    "EXCEL_WORKER_SHARED_SECRET": "{{ secrets.EXCEL_WORKER_SHARED_SECRET }}",
    "EXCEL_WORKER_SERVICE_TOKEN": "{{ secrets.EXCEL_WORKER_SERVICE_TOKEN }}",
    "APP_URL": "{{ secrets.APP_URL }}",
  },
  "placement": {
    "mode": "smart",
  },
  "upload_source_maps": true,
}
