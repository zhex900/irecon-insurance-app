# Staging / Cloudflare Workers deploy secrets (not used by local `npm run dev`)
# Copy to .env.staging and fill in values from Supabase → Project Settings → API.
#
# DATABASE_URL — use the pooler URL (port 6543), not db.*.supabase.co:5432
# SUPABASE_ANON_KEY — required for login (legacy anon JWT or publishable key)
# SUPABASE_SERVICE_ROLE_KEY — required for Settings → Users admin APIs
# APP_URL — public origin used in password-reset emails (must match Auth redirect allow list)
# RESEND_API_KEY / EMAIL_FROM — policy document email via Resend (optional EMAIL_REPLY_TO)
#
# DATABASE_URL=postgresql://postgres.tjnsygunohylofihoksl:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://tjnsygunohylofihoksl.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=https://insurance-app-staging.zhex900.workers.dev
# RESEND_API_KEY=
# EMAIL_FROM=Irecon Insurance <policies@your-verified-domain>
# EMAIL_REPLY_TO=
# VITE_APP_VERSION — optional; deploy script defaults to staging-<short-commit>
# VITE_APP_VERSION=staging-abc1234

DATABASE_URL=
SUPABASE_URL=https://tjnsygunohylofihoksl.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://insurance-app-staging.zhex900.workers.dev
RESEND_API_KEY=
EMAIL_FROM=
# EMAIL_REPLY_TO=
# VITE_APP_VERSION=
