# UAT / Cloudflare Workers deploy secrets (not used by local `npm run dev`)
# Copy to .env.uat and fill in values from Supabase → Project Settings → API.
#
# DATABASE_URL — use the pooler URL (port 6543), not db.*.supabase.co:5432
# SUPABASE_PUBLISHABLE_KEY — required for login (sb_publishable_...)
# SUPABASE_SECRET_KEY — required for Settings → Users admin APIs (sb_secret_...)
# APP_URL — public origin used in password-reset emails (must match Auth redirect allow list)
# RESEND_API_KEY / EMAIL_FROM — policy document email via Resend (optional EMAIL_REPLY_TO)
#
# Sentry — same DSN as production. Auth token for source map upload on deploy.
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
#
# DATABASE_URL=postgresql://postgres.tjnsygunohylofihoksl:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://tjnsygunohylofihoksl.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# APP_URL=https://uat.irecon.net
# RESEND_API_KEY=
# EMAIL_FROM=Irecon Insurance <policies@your-verified-domain>
# EMAIL_REPLY_TO=
# VITE_APP_VERSION — optional; deploy script defaults to uat-<short-commit>
# VITE_APP_VERSION=uat-abc1234
#
# Turnstile — site key is baked into the client build (VITE_*); secret is a Worker secret.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
#
# App-level session limits (Worker vars; 0 disables). Defaults: 30 min idle / 12 h absolute.
# SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12
#
# Preview / per-PR environments (`npm run deploy --env pr-11`)
# PR DBs are Supabase branches off this UAT project. R2 buckets are copied from UAT.
# SUPABASE_ACCESS_TOKEN=   # https://supabase.com/dashboard/account/tokens
# SUPABASE_ORG_ID=         # org slug from `npx supabase orgs list` (optional if you have one org)
# PREVIEW_REGION=ap-southeast-2
# PREVIEW_BRANCH_WITH_DATA=true   # clone UAT data into PR branches (default true)
# WORKERS_DEV_SUBDOMAIN=zhex900
# UAT_SUPABASE_REF=tjnsygunohylofihoksl

DATABASE_URL=
SUPABASE_URL=https://tjnsygunohylofihoksl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=https://uat.irecon.net
RESEND_API_KEY=
EMAIL_FROM=
# EMAIL_REPLY_TO=
# VITE_APP_VERSION=
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_ORG_ID=
